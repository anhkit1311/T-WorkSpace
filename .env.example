API_PORT=3001
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001
DATABASE_URL=postgresql://workspace:workspace@localhost:5432/realtime_workspace
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_SESSION_DAYS=30

# Google OAuth
# Use the same Web application client ID for API and frontend.
# Google Auth Platform > Clients > Authorized JavaScript origins:
# http://localhost and your WEB_ORIGIN (no path/trailing slash).
# Vite uses WEB_ORIGIN's port; the default sample is 5173.
# See docs/guides/google-oauth-local.md. Restart Vite after changing VITE_*.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REQUIRE_GOOGLE_OTP=false
VITE_GOOGLE_CLIENT_ID=

# Email / OTP Delivery (Resend API or SMTP; one provider is required)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="nexo <no-reply@example.com>"

# OTP Policies
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5

# Workspace file quota (includes uploads not yet attached to a message)
WORKSPACE_FILE_QUOTA_BYTES=536870912

# Meeting limits count distinct users, including waiting users; tabs have a separate limit.
MEETING_MAX_USERS=20
MEETING_MAX_TABS_PER_USER=2
MEETING_MAX_SOURCES_PER_PEER=3
# coturn use-auth-secret; ephemeral credentials expire after one hour.
TURN_URLS=
TURN_SHARED_SECRET=

# API and realtime scaling (all nodes share database/channel prefix)
DB_POOL_MAX=10
SOCKET_ADAPTER=local
SOCKET_CHANNEL_PREFIX=collabspace
API_INSTANCE_ID=
SFU_PUBLIC_URL=
VITE_SFU_URL=
MEDIASOUP_WORKERS=2
# Must be reachable by browsers: public IP in production, LAN IP (e.g. 192.168.1.x) in development.
# Browsers do not gather loopback candidates, so 127.0.0.1 silently forces ICE-TCP instead of UDP.
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
REQUEST_LOGS=false
OPERATIONS_TOKEN=
# db preserves existing bytea uploads; s3 uses the standard AWS credential chain.
FILE_STORAGE_PROVIDER=db
USER_FILE_QUOTA_BYTES=134217728
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Q2: also keep finished media (HLS, captions, lesson PDFs) in the bucket so any API instance serves it.
MEDIA_STORAGE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Password shared by the demo accounts of npm run seed:academic (local development only)
SEED_ACADEMIC_PASSWORD=

# Call center (Asterisk 22). Both passwords are required by `npm run callcenter:up`; use long random values.
ASTERISK_ARI_URL=http://localhost:8088
ASTERISK_ARI_USER=nexo
ASTERISK_ARI_PASSWORD=
# M1 phone dial-in (extension 7000): how FFmpeg reaches the SFU and how Asterisk reaches FFmpeg.
# Dev with containers: PHONE_SFU_HOST=host.docker.internal, PHONE_MEDIA_HOST=ffmpeg.
PHONE_SFU_HOST=127.0.0.1
PHONE_MEDIA_HOST=127.0.0.1
MEETING_DIALIN_NUMBER=7000
# M3 captions: OpenAI-compatible speech-to-text, e.g. https://api.openai.com/v1/audio/transcriptions
# or a self-hosted faster-whisper server (http://localhost:8000/v1/audio/transcriptions). Empty = off.
TRANSCRIBE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_LANGUAGE=vi
# Password of the spike extensions 1001/1002 (softphone, UDP) and 1101 (browser, WebSocket); 12+ characters.
ASTERISK_SPIKE_SIP_PASSWORD=
# Address phones and browsers use to reach Asterisk: 127.0.0.1 on one machine, LAN or public IP otherwise.
ASTERISK_EXTERNAL_IP=127.0.0.1
VITE_SIP_WS_URL=ws://localhost:8088/ws

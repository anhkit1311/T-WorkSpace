APP_DOMAIN=collab.example.com
POSTGRES_DB=realtime_workspace
POSTGRES_USER=workspace
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
MEDIASOUP_ANNOUNCED_IP=203.0.113.10
TLS_CERTS_DIR=/etc/letsencrypt
ACME_WEBROOT_DIR=/var/www/certbot
SMTP_FROM=nexo <no-reply@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DB_POOL_MAX=10
SOCKET_ADAPTER=local
SOCKET_CHANNEL_PREFIX=collabspace
API_INSTANCE_ID=
SFU_PUBLIC_URL=
VITE_SFU_URL=
MEDIASOUP_WORKERS=2
MEETING_MAX_USERS=20
MEETING_MAX_TABS_PER_USER=2
MEETING_MAX_SOURCES_PER_PEER=3
# TURN (start with: docker compose --profile turn ...). Example for collab.example.com:
# TURN_URLS=turn:collab.example.com:3478?transport=udp,turn:collab.example.com:3478?transport=tcp,turns:collab.example.com:5349?transport=tcp
TURN_URLS=
TURN_SHARED_SECRET=
# Only behind 1:1 NAT: --external-ip=<public-ip>/<private-ip>
TURN_EXTERNAL_IP_ARG=
REQUEST_LOGS=true
OPERATIONS_TOKEN=
FILE_STORAGE_PROVIDER=db
WORKSPACE_FILE_QUOTA_BYTES=536870912
USER_FILE_QUOTA_BYTES=134217728
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Call center (Asterisk). EXTERNAL_IP = public IP that phones/browsers send RTP to (10000-10099/udp).
ASTERISK_ARI_PASSWORD=replace-with-a-long-random-password
ASTERISK_SPIKE_SIP_PASSWORD=replace-with-at-least-12-characters
ASTERISK_EXTERNAL_IP=203.0.113.10

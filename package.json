{
  "name": "nexo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "test:integration": "npm run build --workspace @doan/api && node scripts/testing/test-integration.mjs",
    "test:sfu": "npm run build --workspace @doan/api && node scripts/testing/test-integration.mjs --sfu",
    "benchmark": "npm run build --workspace @doan/api && node scripts/benchmarks/benchmark-realtime.mjs",
    "benchmark:chat": "npm run build --workspace @doan/api && node scripts/benchmarks/benchmark-chat-load.mjs",
    "verify:restore": "npm run build --workspace @doan/api && node scripts/database/verify-restore.mjs",
    "dev:api": "npm --workspace @doan/api run dev",
    "dev:web": "npm --workspace @doan/web run dev",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:migrate": "npm --workspace @doan/api run db:migrate",
    "build": "npm run build --workspace @doan/shared && npm run build --workspace @doan/api && npm run build --workspace @doan/web",
    "typecheck": "npm run build --workspace @doan/shared && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build --workspace @doan/shared && npm run build --workspace @doan/api && npm run test --workspaces --if-present",
    "start:api": "npm --workspace @doan/api run start",
    "start:web": "npm --workspace @doan/web run preview"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
